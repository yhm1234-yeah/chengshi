# ================= 城事 · 环境变量示例 =================
# 复制为 .env.local 后按需填写。全部留空时系统自动进入 Mock 演示模式，
# 不调用任何外部模型，评审现场零依赖即可完整演示。

# ---- 数据层 ----
# mock（默认，内存 + JSON 种子） | pg（PostgreSQL 16 + pgvector）
STORAGE_DRIVER=mock

# 仅 STORAGE_DRIVER=pg 时需要
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/chengshi

# ---- 会话 ----
AUTH_SECRET=chengshi-demo-secret-change-me
# 演示模式：页脚与页面顶部显示"演示数据，非真实政务系统"
DEMO_MODE=true

# ---- 视觉模型（通义千问 VL，OpenAI 兼容端点）----
VLM_PROVIDER=qwen
VLM_API_KEY=
VLM_MODEL=qwen-vl-max
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 备用视觉模型（可选）
VLM_FALLBACK_API_KEY=
VLM_FALLBACK_MODEL=gpt-4o
VLM_FALLBACK_BASE_URL=https://api.openai.com/v1

# ---- 文本模型（DeepSeek V3，OpenAI 兼容端点）----
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ---- 向量模型 ----
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ---- 地图（高德 JS API 2.0）----
# 未配置时自动降级为内置 SVG 示意地图
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# ---- MCP ----
MCP_TRANSPORT=stdio
MCP_TOKEN=demo-mcp-token

# ---- AI 安全阈值 ----
CONFIDENCE_THRESHOLD=0.75
SPLIT_CONFIDENCE_THRESHOLD=0.7
RAG_SCORE_THRESHOLD=0.2
